--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/msm8916-thwc-jz02v10.dts
@@ -0,0 +1,141 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * THWC JZ02V10 — MSM8916 4G LTE stick with four AP-side SIM switch lines.
+ *
+ * Ported from the openstick-jz02v10 device of the immortalwrt tree
+ * (dts/msm8916-thwc-jz02v10.dts): same GPIO map, plus the shared ramoops
+ * region every board in this target carries.
+ *
+ * This is NOT the same board as generic-jz02 (patch 868).  The JZ02 has three
+ * switch lines plus a hot-detect pulse and a battery; the JZ02V10 exposes four
+ * independent one-hot switch lines and a Restart key on GPIO37.
+ *
+ *   sim:sel   GPIO1    slot 1
+ *   sim:en    GPIO20   slot 2
+ *   sim:sel2  GPIO22   slot 3
+ *   sim:en2   GPIO23   slot 4
+ *
+ * Userspace drives the lines through /sys/class/leds (gpio-leds), one high at
+ * a time; base-files/etc/init.d/sim-select-jz02v10 owns the policy
+ * (uci sim.slot).
+ *
+ * Deliberately left out, because there is no unit to measure on yet:
+ *   - battery / charger: the reference device ships bus-powered, so the
+ *     msm8916-ufi.dtsi usbin extcon is kept as-is.  A unit with a cell needs
+ *     the battery + pm8916_charger/pm8916_bms block from patch 868 and
+ *     luci-app-battery in DEVICE_PACKAGES;
+ *   - qcom,a2-pin on &bam_dmux: not needed by the reference device.  If this
+ *     unit's modem enters the "pc-ack timeout during resume" SSR loop under
+ *     data traffic, add the property (patch 868 has the explanation);
+ *   - GPT_TOT_SECTORS: unknown eMMC size, so the build default is kept and
+ *     flash.sh reads the real size at flash time.
+ */
+
+/dts-v1/;
+
+#include "msm8916-ufi.dtsi"
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/leds/common.h>
+
+/ {
+	model = "THWC JZ02V10 4G LTE Stick";
+	compatible = "jz02v10,generic", "thwc,jz02v10", "qcom,msm8916";
+};
+
+/* Persistent kernel log (ramoops) — same region as every other board. */
+&reserved_memory {
+	ramoops@8db00000 {
+		compatible = "ramoops";
+		reg = <0x0 0x8db00000 0x0 0x00100000>;
+		record-size = <0x00040000>;
+		console-size = <0x00040000>;
+		pmsg-size = <0x00040000>;
+		ecc-size = <16>;
+	};
+};
+
+/*
+ * Status LEDs.  The tri-colour nodes are inherited from msm8916-ufi.dtsi and
+ * keep that file's colour/function pairing, which is exactly what the LED
+ * monitors in this tree resolve:
+ *
+ *   red:power   GPIO8   power-off "goodbye" blink (rc.button/power) and the
+ *                       wan_fault fallback in leds.sh
+ *   green:wlan  GPIO6   Wi-Fi activity (wifi-led-monitor)
+ *   blue:wan    GPIO7   cellular activity (modem-led-monitor)
+ *
+ * Colour and function repeat the msm8916-ufi.dtsi values on purpose: the patch
+ * then documents the whole lamp map, and the bench checklist generated by
+ * tests/board-profile/signoff.sh lists every lamp instead of only the SIM
+ * lines.
+ */
+&led_r {
+	function = LED_FUNCTION_POWER;
+	color = <LED_COLOR_ID_RED>;
+	gpios = <&tlmm 8 GPIO_ACTIVE_HIGH>;
+};
+
+&led_g {
+	function = LED_FUNCTION_WLAN;
+	color = <LED_COLOR_ID_GREEN>;
+	gpios = <&tlmm 6 GPIO_ACTIVE_HIGH>;
+};
+
+&led_b {
+	function = LED_FUNCTION_WAN;
+	color = <LED_COLOR_ID_BLUE>;
+	gpios = <&tlmm 7 GPIO_ACTIVE_HIGH>;
+};
+
+/*
+ * SIM switch lines, kept as gpio-leds so userspace can drive them through
+ * /sys/class/leds exactly like the reference firmware does.  Exactly one line
+ * is high at a time; sim-select-jz02v10 sets that up at boot from uci
+ * sim.slot.
+ */
+&{/leds} {
+	led-sim-sel {
+		label = "sim:sel";
+		gpios = <&tlmm 1 GPIO_ACTIVE_HIGH>;
+		default-state = "on";
+	};
+
+	led-sim-en {
+		label = "sim:en";
+		gpios = <&tlmm 20 GPIO_ACTIVE_HIGH>;
+		default-state = "off";
+	};
+
+	led-sim-sel2 {
+		label = "sim:sel2";
+		gpios = <&tlmm 22 GPIO_ACTIVE_HIGH>;
+		default-state = "off";
+	};
+
+	led-sim-en2 {
+		label = "sim:en2";
+		gpios = <&tlmm 23 GPIO_ACTIVE_HIGH>;
+		default-state = "off";
+	};
+};
+
+&gpio_leds_default {
+	pins = "gpio1", "gpio6", "gpio7", "gpio8",
+	       "gpio20", "gpio22", "gpio23";
+};
+
+/*
+ * Restart key: GPIO37, active high with a pull-down, as in the reference
+ * device tree.  It is the pin the stock Android DTB calls key_f2, i.e. the
+ * plausible reset pinhole line.  Failsafe mode depends on it: tap once inside
+ * the 7 s preinit window.
+ */
+&button_restart {
+	gpios = <&tlmm 37 GPIO_ACTIVE_HIGH>;
+};
+
+&button_default {
+	pins = "gpio37";
+	bias-pull-down;
+};
